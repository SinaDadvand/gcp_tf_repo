# Local .terraform working directory (downloaded provider binaries)
.terraform/

# Do NOT ignore .terraform.lock.hcl! (Commit it to version control)

# Terraform state files (in case you ever run local state by accident)
*.tfstate
*.tfstate.*

# Secret / environment-specific variable files
# *.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log